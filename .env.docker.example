# Docker environment variables for PM Synapse
# Copy to .env.docker and fill with real values:
#   cp .env.docker.example .env.docker
# Used by docker-compose.yml at runtime (NOT during image build).

# Docker Hub image owner (used by compose image name)
DOCKER_USERNAME=myuser

# Database (compose MySQL service is reachable as host "mysql")
DB_PROVIDER=mysql
DB_HOST=mysql
DB_PORT=3306
DB_USER=synapse
DB_PASSWORD=change-me-strong-db-password
DB_NAME=pm_synapse
# Host port mapping for Synapse MySQL (avoid clashing with PM on 3306)
SYNAPSE_MYSQL_PORT=3307

# Session JWT (REQUIRED)
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-synapse-jwt-secret-min-64-chars
ENCRYPTION_KEY=

# Project Management SSO
# PM must list this callback in ALLOWED_SSO_REDIRECTS
PM_BASE_URL=http://host.docker.internal:3000
SSO_CLIENT_ID=pm-synapse
SSO_CLIENT_SECRET=change-me-synapse-sso-secret

# Public URLs (browser-facing)
NEXT_PUBLIC_APP_URL=http://localhost:3010
NEXT_PUBLIC_PM_BASE_URL=http://localhost:3000
