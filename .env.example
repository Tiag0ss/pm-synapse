# PM Synapse
PORT=3010
NODE_ENV=development
JWT_SECRET=change-me-synapse-jwt-secret
# Optional: AES key for SSO tokens / SMTP password / PM API key (falls back to JWT_SECRET)
ENCRYPTION_KEY=

DB_PROVIDER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=synapse
DB_PASSWORD=change-me-synapse-db-password
DB_NAME=pm_synapse

# Project Management (optional — local login works without these)
PM_BASE_URL=http://localhost:3000
SSO_CLIENT_ID=pm-synapse
SSO_CLIENT_SECRET=change-me-synapse-sso-secret
# Optional bootstrap: instance-wide PM personal API token (pt_…) when no per-user SSO token.
# Prefer Settings → Project Management in the UI for non-secret-store installs.
PM_API_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3010
